    MavenRepository("https://repo1.maven.org/maven2/"),
    MavenRepository("https://packages.confluent.io/maven/"),
    MavenRepository("https://linkedin.jfrog.io/artifactory/avro-util/"),
    MavenRepository("https://repository.apache.org/content/repositories/releases/"),
    MavenRepository("https://conjars.org/repo/")
  )

  val defaultScalaVersion = "2.12.18"
  val scalaVersions = Seq(defaultScalaVersion, "2.13.17")

  val jvmId = ""

  // Publishing configuration
  val organization = "ai.zipline"
  val projectUrl = "https://github.com/zipline-ai/chronon"
  val vcsUrl = "https://github.com/zipline-ai/chronon"
  val licenses = Seq(License.`Apache-2.0`)
  val developers = Seq(
    Developer("zipline-ai", "Zipline AI", "https://github.com/zipline-ai")
  )

  def pomSettingsFor(artifactId: String) = PomSettings(
    description = artifactId,
    organization = organization,
    url = projectUrl,
    licenses = licenses,
    versionControl = VersionControl.github("zipline-ai", "chronon"),
    developers = developers
  )

  // Common dependencies
  def commonDeps = Seq(
    mvn"org.scala-lang.modules::scala-collection-compat:2.6.0",
    mvn"org.scala-lang.modules::scala-parser-combinators:2.3.0",
    mvn"org.scala-lang.modules::scala-java8-compat:1.0.2"
  )

  def loggingApiDeps = Seq(
    mvn"org.slf4j:slf4j-api:1.7.36"
  )

  def loggingDeps = loggingApiDeps ++ Seq(
    mvn"ch.qos.logback:logback-classic:1.5.38",
    mvn"ch.qos.logback:logback-core:1.5.38",
    // Used for structured JSON logging (8.x uses Jackson 2.x; 9.x switched to Jackson 3.x)
    mvn"net.logstash.logback:logstash-logback-encoder:8.1"
  )

  // Jackson: Spark 3.5.3 bundles 2.15.2 at runtime via its classloader,
  // so the assembly version only matters for non-Spark processes (service, fetcher).
  // GHSA-72hv-8253-57qq (async parser DoS) is fixed in jackson-core 2.21.1+,
  // but jackson-annotations / jackson-databind aren't published at 2.21.x on
  // Maven Central yet (only 2.19.0 / 2.18.4). A unified jacksonVersion bump
  // is blocked until the full 2.21.x train ships; see .grype.yaml ignore.
  // 2.18.9 patches CVE-2026-545{12,13,14,15} (GHSA-5jmj-h7xm-6q6v and siblings).
  // Staying on the 2.18.x line: the 2.19.x line is unpatched for these until
  // 2.21.4/2.21.5, which aren't on Maven Central either.
  val jacksonVersion = "2.18.9"

  // log4j-1.2-api is the Log4j 1.x bridge bundled with Spark; pin to fix GHSA-h383-gmxw-35v2.
  val log4jVersion = "2.25.5"

  // Iceberg 1.10.0 shades HttpComponents Client 5.5 / Core 5.3.4 into its runtime jar.
  // These versions are vulnerable to GHSA-hjcp-jmpx-g3qm, GHSA-hf6x-8p5f-cgmf,
  // and GHSA-v3jc-474w-2wm6. Keep Iceberg stable while replacing only its shaded
  // HTTP stack with the patched, binary-compatible releases during cloud assembly.
  val httpClient5Version = "5.6.3"
  val httpCore5Version = "5.4.3"

  def icebergHttpPatchAssemblyRules = Seq(
    Assembly.Rule.Relocate(
      "ai.zipline.iceberg.http.patch.**",
      "org.apache.iceberg.shaded.org.apache.hc.@1"
    ),
    // Remove classes that existed in Iceberg's 5.5 / 5.3.4 copies but were removed
    // from the patched releases. Without these rules assembly would retain a union
    // of both versions after the replacement classes win duplicate resolution.
    Assembly.Rule.ExcludePattern(
      "org/apache/iceberg/shaded/org/apache/hc/client5/http/impl/compat/(AbstractSharedBuffer|ClassicToAsyncRequestProducer(\\$IORunnable|\\$InternalOutputStream)?|ClassicToAsyncResponseConsumer(\\$IncomingHttpEntity|\\$InternalInputStream|\\$ResponseData)?|ClassicToAsyncSupport|IOCallback|ProtocolException|SharedInputBuffer|SharedOutputBuffer|TransportException)\\.class"
    ),
    Assembly.Rule.ExcludePattern(
      "org/apache/iceberg/shaded/org/apache/hc/core5/http/impl/bootstrap/HttpAsyncRequester\\$4\\.class"
    ),
    Assembly.Rule.ExcludePattern(
      "org/apache/iceberg/shaded/org/apache/hc/core5/http/impl/io/IncomingHttpEntity\\.class"
    ),
    Assembly.Rule.ExcludePattern(
      "org/apache/iceberg/shaded/org/apache/hc/core5/http/impl/routing/RequestRouter\\$NoAuthorityResolver\\.class"
    ),
    Assembly.Rule.ExcludePattern(
      "org/apache/iceberg/shaded/org/apache/hc/core5/http/nio/AsyncClientEndpoint\\$1\\.class"
    ),
    Assembly.Rule.ExcludePattern(
      "org/apache/iceberg/shaded/org/apache/hc/core5/http2/impl/nio/AbstractH2StreamMultiplexer\\$H2Stream\\.class"
    ),
    Assembly.Rule.ExcludePattern(
      "org/apache/iceberg/shaded/org/apache/hc/core5/http2/impl/nio/bootstrap/H2MultiplexingRequester\\$2\\.class"
    ),
    Assembly.Rule.ExcludePattern(
      "org/apache/iceberg/shaded/org/apache/hc/core5/reactor/AbstractIOSessionPool\\$1\\$1\\.class"
    ),
    Assembly.Rule.ExcludePattern(
      "org/apache/iceberg/shaded/org/apache/hc/core5/reactor/IOWorkers.*"
    ),
    Assembly.Rule.ExcludePattern("META-INF/maven/org\\.apache\\.httpcomponents\\.client5/.*"),
    Assembly.Rule.ExcludePattern("META-INF/maven/org\\.apache\\.httpcomponents\\.core5/.*"),
  )

  def icebergHttpPatchedMetadata = Seq(
    ("org.apache.httpcomponents.client5", "httpclient5", httpClient5Version),
    ("org.apache.httpcomponents.core5", "httpcore5", httpCore5Version),
    ("org.apache.httpcomponents.core5", "httpcore5-h2", httpCore5Version),
  )

  def utilityDeps = Seq(
    mvn"com.fasterxml.jackson.core:jackson-core:$jacksonVersion".forceVersion(),
    mvn"com.fasterxml.jackson.core:jackson-databind:$jacksonVersion".forceVersion(),
    mvn"com.fasterxml.jackson.core:jackson-annotations:$jacksonVersion".forceVersion(),
    mvn"com.fasterxml.jackson.module::jackson-module-scala:$jacksonVersion".forceVersion(),
    mvn"com.fasterxml.jackson.dataformat:jackson-dataformat-yaml:$jacksonVersion".forceVersion(),
    mvn"org.apache.logging.log4j:log4j-1.2-api:$log4jVersion".forceVersion(),
    mvn"com.google.code.gson:gson:2.10.1",
    mvn"org.apache.commons:commons-lang3:3.18.0",
    mvn"org.apache.commons:commons-math3:3.6.1",
    mvn"org.apache.commons:commons-pool2:2.11.1",
    mvn"commons-io:commons-io:2.9.0",
    mvn"com.google.guava:guava:33.3.1-jre",
    mvn"org.yaml:snakeyaml:2.3",
    mvn"com.typesafe:config:1.4.3",
    mvn"javax.annotation:javax.annotation-api:1.3.2"
  )

  def testDeps = Seq(
    mvn"org.scalatest::scalatest:3.2.15",
    mvn"org.scalatest::scalatest-shouldmatchers:3.2.15",
    mvn"org.scalactic::scalactic:3.2.15",
    mvn"org.mockito:mockito-core:5.12.0",
    mvn"org.mockito::mockito-scala:1.17.0",
    mvn"org.scalatestplus::mockito-3-4:3.2.10.0",
    mvn"junit:junit:4.13.2",
    mvn"com.novocode:junit-interface:0.11"
  )

  // Version definitions
  val sparkVersion = "3.5.3"
  def sparkDeps = Seq(
    mvn"org.apache.spark::spark-core:$sparkVersion",
    mvn"org.apache.spark::spark-sql:$sparkVersion",
    mvn"org.apache.spark::spark-catalyst:$sparkVersion",
    mvn"org.apache.spark::spark-hive:$sparkVersion"
      .exclude("org.apache.zookeeper" -> "zookeeper")
      .exclude("org.apache.zookeeper" -> "zookeeper-jute"),
    mvn"org.apache.hadoop:hadoop-client-api:3.3.6",
    mvn"org.apache.hadoop:hadoop-client-runtime:3.3.6",
    mvn"org.apache.iceberg::iceberg-spark-runtime-3.5:1.10.0",
  )

  val flinkVersion = "1.17.0"
  def providedFlinkDeps = Seq(
    mvn"org.apache.flink:flink-streaming-java:$flinkVersion",
    mvn"org.apache.flink:flink-clients:$flinkVersion",
  )

  val avroVersion = "1.12.1"
  val protobufVersion = "3.25.5"
  // 12.0.36 fixes GHSA-f4v5-65jj-pcr2 and GHSA-7p3p-8qv8-m2vh.
  val jettyVersion = "12.0.36"
  // GHSA-2qj4-mmr9-4v2f (High) / GHSA-8c42-7qj2-3j46 (Medium): netty-transport-sctp and
  // netty-codec-http vulnerabilities, fixed in 4.1.137.Final
  val nettyVersion = "4.1.137.Final"
  
  // Common JVM arguments for all test modules
  def commonTestForkArgs = Seq(
    "--add-opens=java.base/java.lang=ALL-UNNAMED",
    "--add-opens=java.base/java.lang.invoke=ALL-UNNAMED",
    "--add-opens=java.base/java.lang.reflect=ALL-UNNAMED",
    "--add-opens=java.base/java.io=ALL-UNNAMED",
    "--add-opens=java.base/java.net=ALL-UNNAMED",
    "--add-opens=java.base/java.nio=ALL-UNNAMED",
    "--add-opens=java.base/java.util=ALL-UNNAMED",
    "--add-opens=java.base/java.util.concurrent=ALL-UNNAMED",
    "--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED",
    "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED",
    "--add-opens=java.base/sun.nio.cs=ALL-UNNAMED",
    "--add-opens=java.base/sun.security.action=ALL-UNNAMED",
    "--add-opens=java.base/sun.util.calendar=ALL-UNNAMED",
    "--add-opens=java.base/java.time=ALL-UNNAMED",
    "-Dorg.slf4j.simpleLogger.defaultLogLevel=ERROR",
    "-Dlogback.configurationFile=logback-test.xml"
  )

  // GCS publishing configuration
  val defaultGcsBucket = "gs://zipline-artifacts-canary"
  val defaultGcsBasePath = "release"

  // spark-hive + hive-common shade hive-exec and other artifacts but leave their original pom
  // metadata, which grype flags as vulnerable. Strip it since the code is shaded.
  def hiveAssemblyRules = Seq(
    Assembly.Rule.ExcludePattern("META-INF/maven/org\\.apache\\.hive/.*"),
    Assembly.Rule.ExcludePattern("META-INF/maven/org\\.apache\\.hive\\.shims/.*"),
    Assembly.Rule.ExcludePattern("META-INF/maven/org\\.datanucleus/.*"),
    Assembly.Rule.ExcludePattern("META-INF/maven/org\\.jline/.*"),
    Assembly.Rule.ExcludePattern("META-INF/maven/jline/.*"),
    Assembly.Rule.ExcludePattern("META-INF/maven/log4j/.*"),
    Assembly.Rule.ExcludePattern("META-INF/maven/org\\.apache\\.avro/.*"),
    Assembly.Rule.ExcludePattern("META-INF/maven/org\\.apache\\.hadoop/hadoop-yarn-.*/.*"),
    Assembly.Rule.ExcludePattern("META-INF/maven/com\\.nimbusds/.*"),
    Assembly.Rule.ExcludePattern("META-INF/maven/commons-beanutils/.*"),
    Assembly.Rule.ExcludePattern("META-INF/maven/org\\.apache\\.commons/commons-configuration2/.*"),
    Assembly.Rule.ExcludePattern("META-INF/maven/org\\.eclipse\\.jetty/jetty-http/.*"),
  )
}

// Custom PublishModule trait that adds GCS publishing capabilities
trait GcsPublishModule extends PublishModule {
  // Self-type to ensure this trait is mixed with CrossScalaModule
  this: CrossScalaModule =>

  import java.time.Instant

  /**
   * GCS bucket to publish artifacts to. Override in modules to customize.
   */
  def gcsBucket: String = Constants.defaultGcsBucket

  /**
   * Base path within the GCS bucket. Override to customize.
   */
  def gcsBasePath: String = Constants.defaultGcsBasePath

  /**
   * Deploy artifact name for GCS. Defaults to artifactName + "_deploy.jar"
   */
  def gcsArtifactName: Task[String] = Task { s"${artifactName()}_deploy.jar" }

  /**
   * Whether this module should be published to GCS. Override to disable for specific modules.
   */
  def publishToGcsEnabled: Boolean = true

  /**
   * Get git metadata for artifact tagging
   */
  private def getGitMetadata(): Map[String, String] = {
    try {
      val commit = os.proc("git", "rev-parse", "HEAD").call().out.text().trim
      val branch = os.proc("git", "rev-parse", "--abbrev-ref", "HEAD").call().out.text().trim
      val date = Instant.now().toString
      Map(
        "commit" -> commit,
        "branch" -> branch,
        "updated_date" -> date
      )
    } catch {
      case e: Exception =>
        println(s"Warning: Could not get git metadata: ${e.getMessage}")
        Map("updated_date" -> Instant.now().toString)
    }
  }

  /**
   * Publish assembly JAR to GCS with metadata
   */
  def publishGcsAssembly() = Task.Command {
    if (!publishToGcsEnabled) {
      println(s"GCS publishing disabled for ${artifactName()}")
      ()
    } else {
      // Get the assembly jar path
      val jarPathRef = assembly()
      val jarPath = jarPathRef.path

      if (!os.exists(jarPath)) {
        throw new Exception(s"Assembly JAR not found at $jarPath. Run assembly task first.")
      }

      // Build GCS destination path
      val version = publishVersion()
      val scalaVer = scalaVersion()
      val deployName = gcsArtifactName()
      val gcsPath = s"$gcsBucket/$gcsBasePath/$version/jars/$deployName"

      println(s"Publishing ${artifactName()} to GCS...")
      println(s"  Version: $version")
      println(s"  Scala: $scalaVer")
      println(s"  Source: $jarPath")
      println(s"  Destination: $gcsPath")

      // Get git metadata
      val metadata = getGitMetadata() + ("scala_version" -> scalaVer)
      val metadataStr = metadata.map { case (k, v) => s"$k=$v" }.mkString(",")

      // Upload to GCS
      try {
        os.proc("gcloud", "storage", "cp", jarPath.toString, gcsPath)
          .call(stdout = os.Inherit, stderr = os.Inherit)

        // Set metadata
        os.proc(
          "gcloud", "storage", "objects", "update", gcsPath,
          s"--custom-metadata=$metadataStr"
        ).call(stdout = os.Inherit, stderr = os.Inherit)

        println(s"  ✓ Successfully published ${artifactName()} to $gcsPath")
      } catch {
        case e: Exception =>
          throw new Exception(s"Failed to publish to GCS: ${e.getMessage}", e)
      }
    }
  }

  /**
   * Publish JAR artifact (not assembly) to GCS
   */
  def publishGcsJar() = Task.Command {
    if (!publishToGcsEnabled) {
      println(s"GCS publishing disabled for ${artifactName()}")
      ()
    } else {
      // Get the JAR path
      val jarPathRef = jar()
      val jarPath = jarPathRef.path

      if (!os.exists(jarPath)) {
        throw new Exception(s"JAR not found at $jarPath.")
      }

      // Build GCS destination path
      val version = publishVersion()
      val scalaVer = scalaVersion()
      val jarName = s"${artifactName()}-${scalaVer}-${version}.jar"
      val gcsPath = s"$gcsBucket/$gcsBasePath/$version/libs/$jarName"

      println(s"Publishing ${artifactName()} JAR to GCS...")
      println(s"  Version: $version")
      println(s"  Scala: $scalaVer")
      println(s"  Source: $jarPath")
      println(s"  Destination: $gcsPath")

      // Get git metadata
      val metadata = getGitMetadata() + ("scala_version" -> scalaVer)
      val metadataStr = metadata.map { case (k, v) => s"$k=$v" }.mkString(",")

      // Upload to GCS
      try {
        os.proc("gcloud", "storage", "cp", jarPath.toString, gcsPath)
          .call(stdout = os.Inherit, stderr = os.Inherit)

        // Set metadata
        os.proc(
          "gcloud", "storage", "objects", "update", gcsPath,
          s"--custom-metadata=$metadataStr"
        ).call(stdout = os.Inherit, stderr = os.Inherit)

        println(s"  ✓ Successfully published ${artifactName()} JAR to $gcsPath")
      } catch {
        case e: Exception =>
          throw new Exception(s"Failed to publish JAR to GCS: ${e.getMessage}", e)
      }
    }
  }
}

// Base module configuration
trait BaseModule extends CrossScalaModule with ScalafmtModule with GcsPublishModule {
  def jvmId = Constants.jvmId

  def repositoriesTask = Task.Anon { super.repositoriesTask() ++ Constants.repositories }

  def scalacOptions = Seq(
    "-deprecation",
    "-feature",
    "-unchecked",
    "-language:implicitConversions",
    "-language:postfixOps",
    "-language:reflectiveCalls",
    "-release:11"
  )

  def javacOptions = Seq("--release", "11")

  // Merge strategy for assembly
  override def assemblyRules = Assembly.defaultRules ++ Seq(
    Assembly.Rule.AppendPattern("META-INF/services/*", "\n")
  )

  // Add Multi-Release manifest attribute for Java 18+ multi-release JAR support
  // Needed for jars like dnsjava that include multi-release classes (see: https://github.com/dnsjava/dnsjava/issues/329)
  override def manifest = Task {
    super.manifest().add("Multi-Release" -> "true")
  }

  // Include both Scala and Java sources, exclude test sources from main compilation
  override def sources = Task.Sources(
    moduleDir / "src" / "main" / "scala",
    moduleDir / "src" / "main" / "java"
  )

  // PublishModule implementation
  def pomSettings = PomSettings(
    description = artifactName(),
    organization = Constants.organization,
    url = Constants.projectUrl,
    licenses = Constants.licenses,
    versionControl = VersionControl.github("zipline-ai", "chronon"),
    developers = Constants.developers
  )

  // Task.Input + Task.env so the version participates in cache invalidation: a plain Task
  // reading sys.env is cached in out/ across commits (CI restores out/), which froze stale
  // strings (0.0.32, 1.17.3+sha) into released jar manifests.
  override def publishVersion = Task.Input { Task.env.getOrElse("CHRONON_VERSION", "0.0.32") }
}

// Common test module configuration
trait BaseTestModule extends ScalaModule with TestModule.ScalaTest {
  def jvmId = Constants.jvmId

  def testFramework = "org.scalatest.tools.Framework"

  // Use the same repositories as parent modules
  def repositoriesTask = Task.Anon { super.repositoriesTask() ++ Constants.repositories }

  // Override sources to use the correct test directory
  override def sources = Task.Sources(moduleDir / os.up / "src" / "test" / "scala")

  // Override resources to use the correct test resources directory
  override def resources = Task.Sources(moduleDir / os.up / "src" / "test" / "resources")

  // Enable parallel test execution using Mill's testParallelism
  def testParallelism = true

  // Suites whose class name contains any of these run in their own forked JVM.
  // Used to isolate suites that own a process-wide SparkSession from suites that
  // would otherwise inherit it via getOrCreate (order-dependent contamination).
  def isolatedTestSuites: Seq[String] = Seq.empty
  override def testForkGrouping = Task {
    val (isolated, rest) = discoveredTestClasses().partition(c => isolatedTestSuites.exists(c.contains))
    isolated.map(Seq(_)) ++ (if (rest.nonEmpty) Seq(rest) else Seq.empty)
  }
}

// JUnit 5 test module configuration (for Java tests)
trait BaseJUnitTestModule extends JavaModule with TestModule.Junit5 {
  def jvmId = Constants.jvmId
  // Use the same repositories as parent modules
  def repositoriesTask = Task.Anon { super.repositoriesTask() ++ Constants.repositories }

  // Override sources to use the correct test directory
  override def sources = Task.Sources(moduleDir / os.up / "src" / "test" / "java")

  // Override resources to use the correct test resources directory
  override def resources = Task.Sources(moduleDir / os.up / "src" / "test" / "resources")

  // Enable parallel test execution using Mill's testParallelism
  def testParallelism = true
}

// JUnit 4 test module configuration (for Java tests using JUnit 4)
trait BaseJUnit4TestModule extends JavaModule with TestModule.Junit4 {
  def jvmId = Constants.jvmId
  // Use the same repositories as parent modules
  def repositoriesTask = Task.Anon { super.repositoriesTask() ++ Constants.repositories }

  // Override sources to use the correct test directory
  override def sources = Task.Sources(moduleDir / os.up / "src" / "test" / "java")

  // Override resources to use the correct test resources directory
  override def resources = Task.Sources(moduleDir / os.up / "src" / "test" / "resources")

  // Enable parallel test execution using Mill's testParallelism
  def testParallelism = true
}

// Builds a small, pre-relocated patch jar for Iceberg's shaded HTTP stack. The cloud
// assemblies remove Iceberg's vulnerable copies and relocate this temporary namespace
// into Iceberg's private namespace, without changing unshaded clients such as Azure.
object icebergHttpPatch extends JavaModule {
  def jvmId = Constants.jvmId
  def repositoriesTask = Task.Anon { super.repositoriesTask() ++ Constants.repositories }
  def mvnDeps = Seq(
    mvn"org.apache.httpcomponents.client5:httpclient5:${Constants.httpClient5Version}"
      .exclude("org.slf4j" -> "slf4j-api"),
    mvn"org.apache.httpcomponents.core5:httpcore5:${Constants.httpCore5Version}",
    mvn"org.apache.httpcomponents.core5:httpcore5-h2:${Constants.httpCore5Version}",
  ).map(_.forceVersion())

  override def assemblyRules = Assembly.defaultRules ++ Seq(
    Assembly.Rule.Relocate(
      "org.apache.hc.**",
      "ai.zipline.iceberg.http.patch.@1"
    )
  )
}

// Aggregate target: builds all deploy assemblies in parallel via Mill's task graph.
// Usage: ./mill artifacts[2.12.18]
object artifacts extends Cross[ArtifactsModule](Constants.scalaVersions)
trait ArtifactsModule extends Cross.Module[String] {
  def scalaVersion = crossValue
  def all = Task {
    Seq(
      build.flink(scalaVersion).assembly(),
      build.cloud_gcp(scalaVersion).assembly(),
      build.cloud_aws(scalaVersion).assembly(),
      build.cloud_azure(scalaVersion).assembly(),
      build.service(scalaVersion).assembly(),
      build.flink_connectors.pubsub(scalaVersion).assembly(),
      build.flink_connectors.kinesis(scalaVersion).assembly()
    )
  }
}
