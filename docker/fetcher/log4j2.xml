<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <!-- Container runtimes collect and rotate stdout; do not duplicate logs into the writable image layer. -->
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%level] %logger{36}: %msg%n" />
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="org.apache.spark" level="WARN" />
        <Logger name="org.apache.hadoop" level="WARN" />
        <Logger name="org.apache.kafka" level="WARN" />
        <Logger name="io.netty" level="WARN" />
        <Logger name="io.vertx" level="WARN" />
        <Logger name="io.micrometer" level="ERROR" />
        <Root level="${env:LOG_LEVEL:-info}">
            <AppenderRef ref="Console" />
        </Root>
    </Loggers>
</Configuration>
