{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["winner", "confidence", "summary", "cases", "tradeoffs", "recommendation"],
  "properties": {
    "winner": {
      "type": "string",
      "enum": ["A", "B", "tie"]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "summary": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "winner", "a_score", "b_score", "reason"],
        "properties": {
          "case_id": {"type": "string"},
          "winner": {"type": "string", "enum": ["A", "B", "tie"]},
          "a_score": {"type": "integer", "minimum": 1, "maximum": 5},
          "b_score": {"type": "integer", "minimum": 1, "maximum": 5},
          "reason": {"type": "string"}
        }
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommendation": {"type": "string"}
  }
}
