    "customJson": "{\"airflowDependencies\": [{\"name\": \"wf_workspace_demo_user_activities_with_offset_0\", \"spec\": \"workspace.demo.user_activities/ds={{ macros.ds_add(ds, 0) }}\"}, {\"name\": \"wf_workspace_demo_dim_listings_with_offset_0\", \"spec\": \"workspace.demo.dim_listings/ds={{ macros.ds_add(ds, 0) }}\"}]}",
