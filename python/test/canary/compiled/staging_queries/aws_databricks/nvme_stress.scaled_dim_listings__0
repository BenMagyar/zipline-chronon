  "query": "\n    SELECT\n        CONCAT(CAST(base.listing_id AS STRING), '-', CAST(scale.id AS STRING)) AS stress_row_id,\n        base.listing_id,\n        base.merchant_id,\n        base.price_cents,\n        PMOD(XXHASH64(base.listing_id, scale.id), 1024) AS shuffle_key,\n        CONCAT(SHA2(CONCAT_WS('|', CAST(base.listing_id AS STRING), CAST(scale.id AS STRING), '0'), 256), SHA2(CONCAT_WS('|', CAST(base.listing_id AS STRING), CAST(scale.id AS STRING), '1'), 256), SHA2(CONCAT_WS('|', CAST(base.listing_id AS STRING), CAST(scale.id AS STRING), '2'), 256), SHA2(CONCAT_WS('|', CAST(base.listing_id AS STRING), CAST(scale.id AS STRING), '3'), 256), SHA2(CONCAT_WS('|', CAST(base.listing_id AS STRING), CAST(scale.id AS STRING), '4'), 256), SHA2(CONCAT_WS('|', CAST(base.listing_id AS STRING), CAST(scale.id AS STRING), '5'), 256), SHA2(CONCAT_WS('|', CAST(base.listing_id AS STRING), CAST(scale.id AS STRING), '6'), 256), SHA2(CONCAT_WS('|', CAST(base.listing_id AS STRING), CAST(scale.id AS STRING), '7'), 256)) AS stress_payload,\n        base.ds\n    FROM workspace.poc.dim_listings AS base\n    CROSS JOIN range(0, 2000000, 1, 1024) AS scale\n    WHERE base.ds BETWEEN {{ start_date }} AND {{ end_date }}\n    DISTRIBUTE BY shuffle_key\n    SORT BY shuffle_key, stress_row_id\n    ",
